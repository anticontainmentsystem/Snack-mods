{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snack-external:v1:envelope-base",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "enum": [
        "command",
        "ack",
        "result",
        "error",
        "event",
        "message"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "connectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "originalSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "body": {
      "type": "object"
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "connectionId",
    "ts",
    "body"
  ]
}
