{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snack-external:v1:error-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "const": false
    },
    "reason": {
      "type": "string",
      "maxLength": 80
    },
    "retryAfter": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "ok",
    "reason"
  ]
}
