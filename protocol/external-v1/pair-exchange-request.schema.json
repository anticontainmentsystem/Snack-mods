{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snack-external:v1:pair-exchange-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "condimentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "installationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "origin": {
      "type": "string",
      "maxLength": 256
    }
  },
  "required": [
    "code",
    "condimentId",
    "installationId",
    "origin"
  ]
}
