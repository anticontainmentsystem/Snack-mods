{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snack-external:v1:resync-accept-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "checkpointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "snapshotSeq": {
      "type": "integer",
      "minimum": 1
    },
    "acknowledgedLoss": {
      "type": "array",
      "items": {
        "$ref": "snack-external:v1:defs#/$defs/loss"
      }
    }
  },
  "required": [
    "connectionId",
    "checkpointId",
    "snapshotSeq",
    "acknowledgedLoss"
  ]
}
