{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snack-external:v1:session-renew-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "const": true
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sessionToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "expires": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "ok",
    "sessionId",
    "sessionToken",
    "expires"
  ]
}
