{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snack-external:v1:defs",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "serviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "loss": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "message",
            "command",
            "result"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "seq",
        "kind"
      ]
    }
  }
}
